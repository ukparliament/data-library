<div>
  <h1>UK Parliament Data Library</h1>
  <p class="lead">Access research publications and deposited papers from the UK Parliament.</p>

  <div class="block block-page">
    <div class="row">
      <div class="col-sm-6">
        <h2>About</h2>
        <p>The Data Library provides access to Parliament's open data, including research briefings, deposited papers, and subject indexing information.</p>

        <h2>Getting Started</h2>
        <p>Use the <strong>Explorer</strong> to browse available resources, or <strong>Search</strong> to find specific parliamentary materials.</p>
        <p>Developers can access data programmatically through our <strong>Data Services</strong> APIs and SPARQL endpoints.</p>

        <h2>Contact</h2>
        <p>For questions or feedback, contact the Data Library team.</p>
      </div>
      <div class="col-sm-6">
        <div id="index">
          <div class="card">
            <a href="<%= search_path %>" class="card">
              <div class="card-inner">
                <div class="content">
                  <div class="primary-info">Search</div>
                  <div class="tertiary-info">Search across all parliamentary data resources</div>
                </div>
              </div>
            </a>
          </div>

          <div class="card">
            <a href="<%= data_services_path %>" class="card">
              <div class="card-inner">
                <div class="content">
                  <div class="primary-info">Data Services</div>
                  <div class="tertiary-info">APIs and data feeds for parliamentary information</div>
                </div>
              </div>
            </a>
          </div>

          <div class="card">
            <a href="<%= data_catalogue_path %>" class="card">
              <div class="card-inner">
                <div class="content">
                  <div class="primary-info">Data Catalogue</div>
                  <div class="tertiary-info">Explore available datasets and their metadata</div>
                </div>
              </div>
            </a>
          </div>

          <div class="card">
            <a href="<%= thesaurus_path %>" class="card">
              <div class="card-inner">
                <div class="content">
                  <div class="primary-info">Thesaurus</div>
                  <div class="tertiary-info">Browse parliamentary subject terms and concepts</div>
                </div>
              </div>
            </a>
          </div>

          <div class="card">
            <a href="https://data-library-browser-85fc677edd07.herokuapp.com/" class="card">
              <div class="card-inner">
                <div class="content">
                  <div class="primary-info">Explorer</div>
                  <div class="tertiary-info">Browse research briefings and deposited papers</div>
                </div>
              </div>
            </a>
          </div>

          <div class="card">
            <a href="<%= tools_path %>" class="card">
              <div class="card-inner">
                <div class="content">
                  <div class="primary-info">Tools</div>
                  <div class="tertiary-info">Applications to support use of parliament's information</div>
                </div>
              </div>
            </a>
          </div>

          <div class="card">
            <a href="<%= roadmap_path %>" class="card">
              <div class="card-inner">
                <div class="content">
                  <div class="primary-info">Roadmap</div>
                  <div class="tertiary-info">Upcoming features and planned developments</div>
                </div>
              </div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
